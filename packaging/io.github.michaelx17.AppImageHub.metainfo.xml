<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.michaelx17.AppImageHub</id>
  <name>AppImage Hub</name>
  <summary>Manage, launch, and update AppImages</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <description>
    <p>
      AppImage Hub is a desktop application for managing AppImage packages on Linux.
      It can import local AppImages, download releases from GitHub, check for updates,
      launch applications, and create desktop or start-menu entries.
    </p>
    <ul>
      <li>Import and organize local AppImages</li>
      <li>Track GitHub releases and download updates</li>
      <li>Launch apps with custom arguments</li>
      <li>Create desktop and application-menu shortcuts</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.michaelx17.AppImageHub.desktop</launchable>
  <icon type="stock">appimage-hub</icon>
